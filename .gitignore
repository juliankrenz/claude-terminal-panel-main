node_modules/
*.vsix
.vscode-test/
.claude/
.DS_Store

# Screenshots dropped into the project folder. Keeping them out of the .vsix needs a
# second entry in .vscodeignore — measured: with .vscodeignore present, vsce ignores
# this file entirely.
Bildschirmfoto*.png
Screenshot*.png
Bildschirmaufnahme*.mov

# Build output (dist/, media/main.js, media/xterm.css) is not ignored here, but that is a
# convention, not a requirement: measured with vsce 3.9.2, `dist/` in this file does NOT
# drop it from the package, because .vscodeignore exists and takes over completely.
# Deleting .vscodeignore would put this file back in charge — then the entry would matter.
# The files stay out of `git status` through .git/info/exclude instead — which held nothing but
# the pristine git template until 2026-08-27, so until then they did not stay out of anything.

# ESLint
.eslintcache

# Editor
.idea/
*.swp
*.swo
*.code-workspace
