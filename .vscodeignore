.vscode/**
.vscode-test/**
src/**
.gitignore
*.map
*.ts
tsconfig.json
# `*.ts` and `tsconfig.json` are matched by vsce without crossing a directory boundary, so
# the webview sources under media/ slipped through and shipped 43 KB of TypeScript to every
# user. The bundle media/main.js is what the webview loads; the sources have no business here.
media/**/*.ts
media/**/tsconfig.json
*.md
.husky/**
.editorconfig
.eslintcache
eslint.config.mjs
.prettierrc.json
.prettierignore
.github/**
.claude/**
scripts/**
*.vsix
Bildschirmfoto*.png
Screenshot*.png
Bildschirmaufnahme*.mov
# vsce matches case-sensitively, unlike git on this filesystem — `screenshot_2.png` slipped past
# the rule above and put 1.9 MB into the package. Readme assets have no business in a .vsix at all:
# *.md is ignored, so the readme that shows them is not even there. media/icon.png and the
# top-level icon.png are the only images the extension itself needs.
media/screenshot*.png
media/Screenshot*.png

# vsce applies negations AFTER every ignore pattern, so a blanket
# "!node_modules/node-pty/**" would pull the whole module back in regardless of order.
# Therefore: ignore all of node_modules, then name exactly what ships.
node_modules/**
!node_modules/node-pty/package.json
!node_modules/node-pty/lib/**
# node-pty's loader (lib/utils.js) checks build/Release first, then
# prebuilds/<platform>-<arch>; spawn-helper must sit next to the loaded pty.node.
!node_modules/node-pty/build/Release/pty.node
!node_modules/node-pty/build/Release/spawn-helper
# Both macOS prebuilds ship: 260 KB together, and the loader picks by process.arch, so a package
# carrying only one fails on the other machine with
# "Cannot find module './prebuilds/<arch>//pty.node'".
!node_modules/node-pty/prebuilds/darwin-x64/**
!node_modules/node-pty/prebuilds/darwin-arm64/**
# Windows needs each of these by name — winpty for the legacy path, conpty for Windows 10+,
# conpty/ for the DLL variant. Listed file by file instead of a `**` glob on purpose: the two
# directories are 58 MB raw, ~95 % of that .pdb debug symbols, and since negations beat every
# ignore pattern regardless of order, a trailing `*.pdb` rule could not take them out again.
!node_modules/node-pty/prebuilds/win32-x64/pty.node
!node_modules/node-pty/prebuilds/win32-x64/conpty.node
!node_modules/node-pty/prebuilds/win32-x64/conpty_console_list.node
!node_modules/node-pty/prebuilds/win32-x64/winpty.dll
!node_modules/node-pty/prebuilds/win32-x64/winpty-agent.exe
!node_modules/node-pty/prebuilds/win32-x64/conpty/**
!node_modules/node-pty/prebuilds/win32-arm64/pty.node
!node_modules/node-pty/prebuilds/win32-arm64/conpty.node
!node_modules/node-pty/prebuilds/win32-arm64/conpty_console_list.node
!node_modules/node-pty/prebuilds/win32-arm64/winpty.dll
!node_modules/node-pty/prebuilds/win32-arm64/winpty-agent.exe
!node_modules/node-pty/prebuilds/win32-arm64/conpty/**

!dist/**
